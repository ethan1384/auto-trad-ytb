# Application
APP_NAME=dubbing-platform
# mock: canned pipeline for unit tests. local: whisper + Argos + ffmpeg (set by Docker Compose).
PROVIDER_MODE=mock
WHISPER_MODEL=base
# cpu on the Mac. The Windows GPU worker sets cuda (float16).
WHISPER_DEVICE=cpu
# Spoken rewrite via Ollama. Qwen 0.5B copies the literal draft, so formulas
# (greetings, farewells, idioms) need a full instruct model. If it is down,
# the Argos line is kept.
OLLAMA_BASE_URL=http://127.0.0.1:11434
REWRITE_MODEL=qwen3.8:27b
CORS_ORIGINS=http://localhost:3000
API_DEV_TOKEN=dev-token

# Database
DATABASE_URL=postgresql+psycopg://dubbing:dubbing@localhost:5432/dubbing

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# S3 (LocalStack via docker compose; official MinIO image may be blocked in some networks)
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=dubbing
S3_REGION=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
