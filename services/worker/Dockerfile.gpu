FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl fonts-dejavu-core espeak-ng libsndfile1 \
    git ca-certificates libglib2.0-0 libgomp1 \
  && rm -rf /var/lib/apt/lists/*

COPY packages/shared /app/packages/shared
COPY services/api /app/services/api
COPY services/worker /app/services/worker

ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=10

# cu128 wheels bundle CUDA and cuDNN, and run on RTX 20xx through 50xx with a
# 570+ driver. The constraint keeps the worker requirements from swapping torch.
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu128 \
  && pip freeze | grep -E '^(torch|torchaudio)==' > /tmp/torch-constraints.txt \
  && pip install --no-cache-dir -e /app/packages/shared \
  && pip install --no-cache-dir -r /app/services/api/requirements-docker.txt -c /tmp/torch-constraints.txt \
  && pip install --no-cache-dir -r /app/services/worker/requirements.txt -c /tmp/torch-constraints.txt

# faster-whisper (CTranslate2) loads cuBLAS and cuDNN by soname, from the
# copies that came with torch.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib

WORKDIR /app/services/api
ENV PYTHONPATH=/app/services/api

CMD ["sh", "/app/services/worker/gpu-worker.sh"]
